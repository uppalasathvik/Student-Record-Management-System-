// ── AUTH ──
function switchAuthTab(tab) {
  document.querySelectorAll('.auth-tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.auth-form').forEach(f => f.classList.remove('active'));
  if(tab === 'login') {
    document.querySelectorAll('.auth-tab')[0].classList.add('active');
    document.getElementById('loginForm').classList.add('active');
  } else {
    document.querySelectorAll('.auth-tab')[1].classList.add('active');
    document.getElementById('signupForm').classList.add('active');
  }
}

function doLogin() {
  const email = document.getElementById('loginEmail').value.trim();
  const pass = document.getElementById('loginPassword').value;
  if(!email || !pass) { showToast('Please fill all fields'); return; }
  const name = email.split('@')[0];
  loginUser(name, email);
}

function doSignup() {
  const name = document.getElementById('signupName').value.trim();
  const email = document.getElementById('signupEmail').value.trim();
  const pass = document.getElementById('signupPassword').value;
  const confirm = document.getElementById('signupConfirm').value;
  if(!name || !email || !pass || !confirm) { showToast('Please fill all fields'); return; }
  if(pass !== confirm) { showToast('Passwords do not match'); return; }
  loginUser(name, email, true);
}

function loginUser(name, email, isNew = false) {
  currentUser = { name, email };
  // Update UI
  document.getElementById('navAvatar').textContent = name[0].toLowerCase();
  document.getElementById('navName').textContent = name;
  document.getElementById('heroName').textContent = name;
  document.getElementById('profileAvatar').textContent = name[0].toLowerCase();
  document.getElementById('profileName').textContent = name;
  document.getElementById('profileEmail').textContent = email;
  document.getElementById('authThemeToggle').style.display = 'none';
  document.getElementById('page-auth').style.display = 'none';
  document.getElementById('app').style.display = 'block';
  if(isNew) {
    showPage('profile');
  } else {
    showPage('home');
    startCounters();
  }
  renderCases();
  injectFooters();
}

// ── PROFILE ──
function selectRole(card) {
  document.querySelectorAll('.role-card').forEach(c => c.classList.remove('selected'));
  card.classList.add('selected');
}

function completeProfile() {
  showPage('home');
  startCounters();
  showToast('Profile complete! Welcome to Lost Souls 🌿');
}

// ── NAVIGATION ──
function navigate(page) {
  showPage(page);
  // Update nav active
  document.querySelectorAll('.nav-links a').forEach(a => a.classList.remove('active'));
  const el = document.getElementById('nav-' + page);
  if(el) el.classList.add('active');
}

function showPage(page) {
  currentPage = page;
  document.querySelectorAll('#app .page').forEach(p => p.classList.remove('active'));
  const target = document.getElementById('page-' + page);
  if(target) {
    target.classList.add('active');
    // Re-trigger animations
    target.querySelectorAll('.animate').forEach(el => {
      el.style.animation = 'none';
      el.offsetHeight; // reflow
      el.style.animation = '';
    });
    window.scrollTo(0,0);
  }
}

// ── CASES ──
function renderCases(filter='all', search='') {
  const grid = document.getElementById('casesGrid');
  if(!grid) return;
  let cases = CASES;
  if(filter !== 'all') cases = cases.filter(c => filter === 'found' ? c.status === 'found' : c.status !== 'found');
  if(search) cases = cases.filter(c => c.name.toLowerCase().includes(search.toLowerCase()) || c.location.toLowerCase().includes(search.toLowerCase()));

  if(currentView === 'grid') {
    grid.style.display = 'grid';
    grid.style.gridTemplateColumns = 'repeat(4,1fr)';
  } else {
    grid.style.display = 'flex';
    grid.style.flexDirection = 'column';
  }

  grid.innerHTML = cases.map(c => {
    const badge = c.status === 'urgent' ? '<span class="case-badge badge-urgent">URGENT</span>' : c.status === 'found' ? '<span class="case-badge badge-found">FOUND</span>' : '';
    if(currentView === 'list') {
      return `<div class="case-card" style="aspect-ratio:unset;display:flex;align-items:center;padding:0;height:80px;border-radius:10px;background:var(--bg-card);border:1px solid var(--border);">
        <img src="${c.img}" style="width:70px;height:80px;object-fit:cover;border-radius:10px 0 0 10px;">
        <div style="padding:0 1rem;flex:1;">
          <strong style="font-size:0.95rem;">${c.name}</strong>
          <p style="font-size:0.8rem;color:var(--text-secondary);">${c.age} yrs • ${c.gender} • ${c.location}</p>
        </div>
        ${badge}
      </div>`;
    }
    return `<div class="case-card">
      <img src="${c.img}" alt="${c.name}" loading="lazy">
      ${badge}
      <div class="case-overlay">
        <h3>${c.name}</h3>
        <p>${c.age} years old • ${c.gender}</p>
        <p class="location">📍 ${c.location}</p>
      </div>
    </div>`;
  }).join('');
}

function filterByStatus(status, btn) {
  currentFilter = status;
  document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
  btn.classList.add('active');
  renderCases(status, document.querySelector('.search-input')?.value || '');
}

function filterCases(search) {
  renderCases(currentFilter, search);
}

function setView(view, btn) {
  currentView = view;
  document.querySelectorAll('.view-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  renderCases(currentFilter);
}

// ── REPORT SUBMIT ──
function submitReport(type) {
  showToast(type === 'missing' ? '✓ Missing person report submitted!' : '✓ Found person report submitted!');
  setTimeout(() => navigate('home'), 1200);
}

function handlePhotoUpload(input) {
  if(input.files && input.files[0]) {
    const zone = input.closest('.upload-zone');
    zone.querySelector('strong').textContent = '✓ ' + input.files[0].name;
    zone.style.borderColor = 'var(--teal)';
  }
}

// ── THEME ──
function toggleTheme() {
  const html = document.documentElement;
  const isDark = html.getAttribute('data-theme') === 'dark';
  html.setAttribute('data-theme', isDark ? 'light' : 'dark');
  const btn = document.querySelector('.nav-theme-btn');
  if(btn) btn.textContent = isDark ? '🌙' : '☀️';
}

// ── COUNTERS ──
function startCounters() {
  document.querySelectorAll('.count-up').forEach(el => {
    const target = parseInt(el.dataset.target);
    const duration = 1800;
    const step = target / (duration / 16);
    let current = 0;
    const timer = setInterval(() => {
      current += step;
      if(current >= target) {
        current = target;
        clearInterval(timer);
      }
      el.textContent = target >= 1000 && target < 100000 ? Math.floor(current/1000) + 'k' : Math.floor(current).toLocaleString();
    }, 16);
  });
}

// ── TOAST ──
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2800);
}

